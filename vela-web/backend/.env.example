PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
DB_SERVER=localhost
# sql (default) or windows (Windows integrated authentication; msnodesqlv8)
DB_AUTH=sql
DB_PORT=1433
DB_NAME=TeachingCenter
DB_USER=sa
DB_PASSWORD=replace-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY_HEX=replace-with-64-hex-characters
# Optional storage path; default is backend/data.
DATA_DIRECTORY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trung tâm học tập <no-reply@example.com>
# No pretend SENT status when SMTP is missing.
MFA_REQUIRED=true
# Optional: leave empty to use Manager payment verification only.
SEPAY_WEBHOOK_API_KEY=
# Put the real company QR in frontend/public and set e.g. /company-qr.png.
# Empty uses the clearly labelled non-scannable placeholder.
COMPANY_QR_URL=
PAYMENT_BANK_CODE=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
FILE_BACKUP_DIRECTORY=
BACKUP_DIRECTORY=
DEMO_PASSWORD=
