# Application Ports
PORT=3000
BACKEND_PORT=4000
NODE_ENV=production
APP_URL=http://localhost:3000
API_UPSTREAM=http://127.0.0.1:4000

# Database Configuration (matches docker-compose.yml sqlserver service)
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=TeachingCenter
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
DB_AUTH=sql
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Security (auto-generated if empty)
# DATA_KEY_HEX=64-character-hex-string
DEMO_PASSWORD=DemoPassword@123

# Automation on startup
AUTO_MIGRATE=true
AUTO_SEED=true

# Email MFA (false disables email OTP requirement for quick demo login)
MFA_REQUIRED=false

# Optional SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trung tâm học tập <no-reply@example.com>
